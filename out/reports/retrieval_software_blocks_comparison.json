  "methods": [
    {
      "id": "1",
      "name": "Parser + LSP Baseline",
      "frontend": "tree-sitter-verilog seed extractor, with regex fallback only when the Python tree-sitter package is unavailable",
      "modules": [
        "platform/ingest/generate_ontology_seed.py",
        "tree_sitter.Parser + tree_sitter_verilog.language()",
        "find_modules_tree_sitter(): module_declaration nodes",
        "module_instantiation AST nodes for child module links",
        "PORT_RE inside each AST module body for input/output/inout ports",
        "platform/eval/retrieval_common.py baseline scorer"
      ],
      "processing": [
        "Walk RTL files under dbs/opentitan and dbs/ibex.",
        "Parse each Verilog/SystemVerilog file with tree-sitter-verilog.",
        "Extract module name, file path, ports, instances, and instance names into JSONL seed rows.",
        "Rank benchmark queries by parser/LSP-style lexical overlap over module name, path, ports, and instances."
      ],
      "strength": "Fast structural lookup from AST-derived RTL facts.",
      "limit": "No KG-only semantic expansion or graph traversal."
    },
    {
      "id": "2",
      "name": "Parser + LSP + Manticore",
      "frontend": "Same tree-sitter-verilog seed as method 1",
      "modules": [
        "platform/eval/run_manticore_retrieval_analysis.py",
        "BM25FIndex local Manticore-style ranker",
        "manticore_documents.jsonl loader-ready full-text documents",
        "manticore_schema.sql for later real Manticore Search loading",
        "tools/manticoresearch local source checkout reference"
      ],
      "processing": [
        "Reuse tree-sitter module facts from merged_ontology_seed.jsonl.",
        "Convert parser/LSP fields into weighted full-text documents.",
        "Rank queries with BM25F-style field weighting over module, path, ports, instances, and instance names.",
        "Emit documents and SQL schema so the same representation can be loaded into Manticore Search later."
      ],
      "strength": "Full-text ranking over parser/LSP fields without requiring KG context.",
      "limit": "The current benchmark uses a local Manticore-style ranker, not a live searchd server."
    },
    {
      "id": "3",
      "name": "Knowledge Graph (Neo4j-style KG snapshot)",
      "frontend": "Same tree-sitter-verilog seed as method 1, plus labels and graph context",
      "modules": [
        "platform/eval/build_full_kg_snapshot.py",
        "out/merged_ontology_seed.jsonl",
        "out/merged_labels.jsonl",
        "out/kg_full/kg_full_nodes_edges.json",
        "platform/eval/retrieval_common.py KG scorer"
      ],
      "processing": [
        "Start from tree-sitter-extracted modules, ports, and instance edges.",
        "Attach labels, summaries, IP block context, reverse parent hints, and inferred graph relationships.",
        "Build a node/edge snapshot that can be mapped to a Neo4j-style graph model.",
        "Rank queries with KG-aware expansion and graph-context signals."
      ],
      "strength": "Best Hit@1 in the current tree-sitter run because labels and graph context help disambiguation.",
      "limit": "Quality depends on label coverage and graph extraction completeness."
    },
    {
      "id": "4",
      "name": "Graphify",
      "frontend": "Graphify AST and knowledge-graph extraction; independent graph builder with tree-sitter-style code structure extraction",
      "modules": [
        "graphify update .",
        "graphify-out/graph.json",
        "graphify-out/GRAPH_REPORT.md",
        "graphify-out/graph_top_communities.html",
        "graphify-out/wiki/index.md when present"
      ],
      "processing": [
        "Scan the whole workspace, including code, docs, scripts, generated reports, and Verilog assets.",
        "Extract entities and EXTRACTED plus INFERRED relationships into a large knowledge graph.",
        "Cluster communities and identify god nodes, bridges, and cross-module structure.",
        "Generate HTML/JSON/Markdown audit artifacts for architecture browsing rather than benchmark-only retrieval."
      ],
      "strength": "Broad workspace-level architecture and community discovery.",
      "limit": "Large graphs can exceed HTML visualization limits; use reports and JSON when the graph is too large."
